# One Supabase project this week, for production and preview deployments.
# Set the URL from the project settings. Do not commit the project ref.
# Before any real family data, preview databases move to Supabase Branching.
# See docs/decisions/0005-code-vs-data.md.
SUPABASE_URL=
# Publishable key. Used for Google sign-in and for a caregiver's own session.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Helpers and the existing handoff routes use this. It bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# HMAC key for helper-link cookies. openssl rand -hex 32
HELPER_SESSION_SECRET=
# Local supabase/config.toml only. Google client from the Cloud console. Not used by the Next server.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Used to build share links. Leave unset locally to use the request origin.
NEXT_PUBLIC_APP_URL=https://www.allhandscare.org
HANDOFF_TTL_DAYS=30
MAX_UPLOAD_MB=10
NEXT_PUBLIC_MAX_UPLOAD_MB=10

# Vercel Cron sends this as a bearer token to /api/cron/purge. Generate with: openssl rand -hex 24
CRON_SECRET=
# Salt for IP, PIN and manage-key hashes. Generate with: openssl rand -hex 24
IP_HASH_SALT=

# Optional: link shown in the manage view ("Did this save you calls or texts?")
NEXT_PUBLIC_FEEDBACK_URL=

# Optional. Leave unset for the built-in parser (the MVP default).
EXTRACTION_PROVIDER=          # heuristic (default) | anthropic
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=             # defaults to claude-opus-5-5
